VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = conecta a los emuladores locales (firebase emulators:start)
VITE_USE_EMULATORS=false

# Nombre de la app (títulos, textos)
VITE_APP_NAME=Sellito

# Direcciones públicas. PROVISORIAS hasta conectar misellito.com.ar; las definitivas serán:
#   VITE_SITE_URL=https://misellito.com.ar        (landing y links de alta /c/{código})
#   VITE_APP_URL=https://app.misellito.com.ar     (panel y escáner)
#   VITE_API_URL=https://api.misellito.com.ar     (Cloud Functions)
VITE_SITE_URL=https://sellito-23c14.web.app
VITE_APP_URL=https://sellito-23c14.web.app
VITE_API_URL=https://southamerica-east1-sellito-23c14.cloudfunctions.net

# App Check (reCAPTCHA Enterprise). La clave del sitio es pública.
VITE_RECAPTCHA_SITE_KEY=
# Token de depuración de App Check: ponerlo en .env.development.local (solo se carga en npm run dev).
VITE_APPCHECK_DEBUG_TOKEN=

# Dominio del login con Google: el del panel (APP_URL sin https), así la ventana de Google muestra tu dominio.
# Requiere la URI https://<dominio>/__/auth/handler en el cliente OAuth de Google Cloud.
# Botón "Entrar con Google": true cuando el proveedor Google está activo en Firebase Auth.
VITE_GOOGLE_SIGNIN=false

# Meta Pixel (campañas): ID del píxel (público). Vacío = no se carga nada.
VITE_META_PIXEL_ID=
