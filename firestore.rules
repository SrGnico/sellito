rules_version = '2';

// Principios (ver SELLITO_SPEC.md §7 y §12):
// - Un dueño solo ve y edita lo de sus propios negocios.
// - Lo que define pagos, PIN o Wallets lo escriben solo las Cloud Functions (Admin SDK, ignora estas reglas).
// - El cliente final y el escáner no tocan Firestore: todo pasa por Functions.
// - El super admin se identifica por custom claim `superadmin`, nunca por un campo editable.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return signedIn() && request.auth.token.superadmin == true;
    }

    function ownsBusiness(businessId) {
      return signedIn()
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
    }

    // Campos que el dueño puede escribir desde el panel.
    function ownerEditableFields() {
      return ['name', 'slug', 'design', 'rule', 'askFields', 'birthday', 'locations', 'proximityEnabled', 'createdAt', 'updatedAt'];
    }

    function validBusinessData(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && (!('locations' in data) || (data.locations is list && data.locations.size() <= 10))
        && (!('proximityEnabled' in data) || data.proximityEnabled is bool)
        && (!('rule' in data) || (data.rule.stampsRequired is int
              && data.rule.stampsRequired >= 2 && data.rule.stampsRequired <= 20))
        && (!('birthday' in data) || validBirthday(data.birthday));
    }

    // Regalo de cumpleaños (functions/src/types.ts, BirthdayConfig).
    function validBirthday(c) {
      return c.keys().hasOnly(['enabled', 'when', 'reward', 'rewardText', 'notify'])
        && c.enabled is bool && c.notify is bool
        && c.when in ['day', 'month'] && c.reward in ['same', 'custom', 'none']
        && (!('rewardText' in c) || (c.rewardText is string && c.rewardText.size() <= 60));
    }

    // Modo lectura con la suscripción vencida (misma lógica que functions/src/payments/access.ts):
    // sin suscripción, activa, en prueba vigente o en gracia se puede editar; si no, no.
    function canEdit(data) {
      let sub = data.get('subscription', {});
      let status = sub.get('status', 'none');
      return status == 'none' || status == 'active'
        || (status == 'trial' && sub.get('trialEndsAt', request.time) > request.time)
        || (status == 'past_due' && sub.get('graceUntil', request.time) > request.time);
    }

    match /businesses/{businessId} {
      allow read: if isSuperadmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      // `subscription`, `scannerPinHash`, `googleClassId`, `appleTemplateRef`, `enrollCode` no se aceptan desde el cliente.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(ownerEditableFields().concat(['ownerUid']))
        && validBusinessData(request.resource.data);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && canEdit(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerEditableFields())
        && validBusinessData(request.resource.data);

      allow delete: if false;

      // Tarjetas y log de sellos: el dueño las lee, solo las Functions las escriben.
      match /cards/{cardId} {
        allow read: if isSuperadmin() || ownsBusiness(businessId);
        allow write: if false;
      }

      // Avisos a los clientes: el dueño ve el historial; los crea y envía una Function.
      match /notices/{noticeId} {
        allow read: if isSuperadmin() || ownsBusiness(businessId);
        allow write: if false;
      }

      match /stamps/{stampId} {
        allow read: if isSuperadmin() || ownsBusiness(businessId);
        allow write: if false;
      }
    }

    match /users/{uid} {
      allow read: if isSuperadmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // Códigos de alta (SITE_URL/c/{código} → businessId): solo Functions.
    match /enrollCodes/{code} {
      allow read, write: if false;
    }

    // Sesiones del escáner y bloqueo por PIN incorrecto: solo Functions.
    match /scannerSessions/{session} {
      allow read, write: if false;
    }
    match /scannerGuards/{businessId} {
      allow read, write: if false;
    }

    // PassKit web service: solo Functions.
    match /appleRegistrations/{doc=**} {
      allow read, write: if false;
    }

    // Planes y precios (los edita el admin desde la consola). Lectura pública: la landing muestra el precio.
    match /config/plans {
      allow read: if true;
      allow write: if false;
    }

    // Analítica por día (functions/src/analytics): solo la lee el superadmin.
    match /analytics/{day} {
      allow read: if isSuperadmin();
      allow write: if false;
    }

    // Cola de mails (los envía deliverMail con Resend): solo Functions.
    match /mail/{id} {
      allow read, write: if false;
    }

    // Todo lo no listado queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
