{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "src"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": [
    {
      "public": "web/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "predeploy": [
        "npm --prefix web run build"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "site": "sellito-23c14"
    },
    {
      "site": "sellito-api",
      "public": "hosting/api",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "/getEnrollInfo",
          "function": {
            "functionId": "getEnrollInfo",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/createCard",
          "function": {
            "functionId": "createCard",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/ensureEnrollCode",
          "function": {
            "functionId": "ensureEnrollCode",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/resyncCards",
          "function": {
            "functionId": "resyncCards",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/testSetStamps",
          "function": {
            "functionId": "testSetStamps",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/health",
          "function": {
            "functionId": "health",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/setScannerPin",
          "function": {
            "functionId": "setScannerPin",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/scannerLogin",
          "function": {
            "functionId": "scannerLogin",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/scannerSession",
          "function": {
            "functionId": "scannerSession",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/scannerLookup",
          "function": {
            "functionId": "scannerLookup",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/scannerStamp",
          "function": {
            "functionId": "scannerStamp",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/createSubscription",
          "function": {
            "functionId": "createSubscription",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/mpWebhook",
          "function": {
            "functionId": "mpWebhook",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/exportCustomers",
          "function": {
            "functionId": "exportCustomers",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/upgradeCards",
          "function": {
            "functionId": "upgradeCards",
            "region": "southamerica-east1"
          }
        },
        {
          "source": "/geocodeAddress",
          "function": {
            "functionId": "geocodeAddress",
            "region": "southamerica-east1"
          }
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
