# Configuración no secreta de las Functions (Firebase la carga al desplegar).
# Los secretos (clave de la cuenta de servicio, Mercado Pago) van en Secret Manager.

# Nombre de la app
APP_NAME=Sellito

# Direcciones públicas.
SITE_URL=https://misellito.com.ar
APP_URL=https://app.misellito.com.ar
API_URL=https://api.misellito.com.ar
# Solo para desarrollo local (sitios desde los que se puede abrir el link de Google Wallet).
DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Wallet: cuenta de emisor (modo demo hasta pedir acceso de publicación)
WALLET_ISSUER_ID=3388000000023205120
WALLET_SERVICE_ACCOUNT=sellito-wallet@sellito-23c14.iam.gserviceaccount.com

# Apple Wallet (Pass Type ID y Team ID; clave y certificado en Secret Manager: APPLE_PASS_KEY / APPLE_PASS_CERT)
APPLE_PASS_TYPE_ID=pass.ar.com.misellito.tarjeta
APPLE_TEAM_ID=38768Z69GW
